# ---------------------------------------------------------------------------
# Application (read by `npm run dev`, `npm start`, `npm run db:*`)
# ---------------------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investment_pool
# Redis connection string (used for rate limiting).
REDIS_URL=redis://localhost:6379
# Session cookies are "Secure" in production by default. Uncomment ONLY if you
# must serve production over plain HTTP (not recommended).
# COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Initial admin account (created by `npm run db:seed`, skipped if it exists)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_NAME=Administrator
# Password of the demo investors created by `npm run db:seed:demo` (default: demo-investor-2026).
# DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Docker Compose only (ignored by `npm run dev`)
# ---------------------------------------------------------------------------
POSTGRES_USER=pool
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=investment_pool
APP_PORT=3000
